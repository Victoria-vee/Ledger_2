{
  "name": "@ledger/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/transactionParsing.test.ts tests/transactionCurrency.test.ts tests/pricingCalculator.test.ts tests/pricingRecommendation.test.ts tests/pricingRecommendationRoutes.test.ts tests/pricingRecordsRoutes.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mongoose": "^9.11.2",
    "openai": "^7.38.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
